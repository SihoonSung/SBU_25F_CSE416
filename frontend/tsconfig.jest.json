{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "types": ["vite/client", "jest", "@testing-library/jest-dom", "node"]
  },
  "include": ["src", "vite-env.d.ts"]
}
